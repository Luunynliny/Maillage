{
  "name": "maillage",
  "comment": "Not the app's version. Nothing reads this — the release version is derived from the commits and lives on the git tag, and this package is never published. See CLAUDE.md's Releasing section.",
  "version": "0.0.0-unused",
  "private": true,
  "type": "module",
  "description": "A personal CRM over a folder of markdown files. Runs locally: a small Node server owns the vault, the browser draws it.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "MAILLAGE_DEV=1 node --watch server/index.ts",
    "build": "vite build",
    "start": "npm run build && node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "prettier": "3.6.2",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
